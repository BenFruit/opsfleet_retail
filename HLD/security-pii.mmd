flowchart TB
    subgraph POLICY["Column access policy — current proposed mapping"]
      A["ALLOWED: IDs, status, products, prices, timestamps"]
      G["AGGREGATE_ONLY: age, gender, city, state, country, traffic_source"]
      P["BLOCKED_PII: name, email, street address, postal code, coordinates, geom"]
    end
    REQ["User request + trusted identity"] --> PLANNER["Agent proposes SQL"]
    PLANNER --> AST["SQLGlot AST / policy validator"]
    RIGHTS["Trusted product entitlements"] --> AST
    POLICY --> AST
    AST -->|"Pass"| DRY["BigQuery dry-run / budgets"]
    AST -->|"Fail"| REJECT["Reject + safe explanation"]
    DRY --> BQ[("BigQuery read-only account")]
    BQ --> SAN["Sanitize results + suppress unsafe groups"]
    SAN -->|"Safe result only"| LLM["Gemini: analyze and decide next step"]
    LLM --> GUARD["Final response guard"]
    GUARD --> USER["User"]
    note["No raw PII to Gemini or third-party telemetry"] -.-> SAN
